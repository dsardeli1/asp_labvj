@model TaskManageApp.Models.TaskItem

@{
    var displayValue = Model.DueDate == default
        ? string.Empty
        : Model.DueDate.ToString("d", CultureInfo.CurrentCulture);
}

<div class="col-md-6">
    <div class="datepicker-field" data-datepicker data-culture="@CultureInfo.CurrentCulture.Name">
        <label asp-for="DueDate" class="form-label"></label>
        <div class="datepicker-shell">
            <input asp-for="DueDate" type="hidden" data-datepicker-value />
            <input class="form-control datepicker-input" type="text" autocomplete="off" inputmode="numeric" maxlength="16" placeholder="@CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern" data-datepicker-input value="@displayValue" />
            <button type="button" class="btn btn-outline-secondary datepicker-toggle" aria-label="Open calendar" data-datepicker-toggle>
                <span aria-hidden="true">&#128197;</span>
            </button>
            <div class="datepicker-panel" hidden data-datepicker-panel></div>
        </div>
        <span asp-validation-for="DueDate" class="text-danger"></span>
        <div class="form-text">Format: @CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern</div>
    </div>
</div>