@model TaskManageApp.Models.TaskHistory

@{
    ViewData["Title"] = "Edit History";
    var tasks = ViewData["Tasks"] as List<TaskManageApp.Models.TaskItem>;
}

<section class="data-entity-page data-entity-page-detail">
    <header class="data-entity-header">
        <h2>Edit History #@Model.Id</h2>
        <p class="text-muted">Update task history record.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataHistories" asp-action="Histories" class="btn btn-outline-secondary btn-sm">Back to Histories</a>
        </div>
    </header>

    <div class="card mb-3 data-detail-card">
        <div class="card-body data-detail-card-body">
            <form asp-controller="DataHistories" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Id" type="hidden" />

                <div class="col-md-6">
                    <label asp-for="TaskItemId" class="form-label"></label>
                    <select asp-for="TaskItemId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(tasks, "Id", "Title"))">
                        <option value="">-- Select Task --</option>
                    </select>
                    <span asp-validation-for="TaskItemId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ActionDate" class="form-label"></label>
                    <input asp-for="ActionDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ActionDate" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Action" class="form-label"></label>
                    <input asp-for="Action" class="form-control" maxlength="255" />
                    <span asp-validation-for="Action" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-controller="DataHistories" asp-action="Histories" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

<partial name="_ValidationScriptsPartial" />