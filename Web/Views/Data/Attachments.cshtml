@model List<TaskManageApp.Models.TaskAttachment>

@{
    ViewData["Title"] = "Task Attachments";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Task Attachments</h2>
        <p class="text-muted">Manage attachment records for tasks.</p>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="data-entity-actions">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="DataAttachments" asp-action="Create" class="btn btn-primary btn-sm">Create Attachment</a>
            }
        </div>
        <form asp-controller="DataAttachments" asp-action="Find" method="get" class="row g-2 mt-2">
            <div class="col-md-8 col-lg-6">
                <select name="id" class="form-select" data-autocomplete-url="/data/attachments/lookup" data-autocomplete-placeholder="Quick find attachment by file name" data-autocomplete-max-results="12">
                    <option value=""></option>
                    @foreach (var attachment in Model.OrderBy(a => a.FileName).ThenBy(a => a.Id))
                    {
                        <option value="@attachment.Id">#@attachment.Id - @attachment.FileName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Open</button>
            </div>
        </form>
    </header>

    <div class="table-responsive data-entity-table-wrap">
        <table class="table table-striped table-hover align-middle data-entity-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>File Name</th>
                    <th>File Path</th>
                    <th>Task</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attachment in Model)
                {
                    <tr>
                        <td><a asp-controller="DataAttachments" asp-action="AttachmentDetails" asp-route-id="@attachment.Id">@attachment.Id</a></td>
                        <td>@attachment.FileName</td>
                        <td>@attachment.FilePath</td>
                        <td>#@attachment.TaskItemId - @attachment.TaskItem?.Title</td>
                        <td>
                            <a asp-controller="DataAttachments" asp-action="AttachmentDetails" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-info">View</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <a asp-controller="DataAttachments" asp-action="Edit" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="DataAttachments" asp-action="Delete" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
