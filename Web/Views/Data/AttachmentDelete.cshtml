@model TaskManageApp.Models.TaskAttachment

@{
    ViewData["Title"] = "Delete Attachment";
}

<section class="data-entity-page data-entity-page-detail">
    <header class="data-entity-header">
        <h2>Delete Attachment #@Model.Id</h2>
        <p class="text-muted">Confirm deletion of this attachment record.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataAttachments" asp-action="Attachments" class="btn btn-outline-secondary btn-sm">Back to Attachments</a>
        </div>
    </header>

    <div class="card mb-3 data-detail-card">
        <div class="card-body data-detail-card-body">
            <div class="alert alert-danger" role="alert">
                <strong>Warning!</strong> This action permanently deletes the attachment and cannot be undone.
            </div>
            <dl class="row mb-0 data-detail-grid">
                <dt class="col-sm-3 data-detail-term">File Name</dt>
                <dd class="col-sm-9 data-detail-desc">@Model.FileName</dd>
                <dt class="col-sm-3 data-detail-term">File Path</dt>
                <dd class="col-sm-9 data-detail-desc">@Model.FilePath</dd>
                <dt class="col-sm-3 data-detail-term">Task</dt>
                <dd class="col-sm-9 data-detail-desc">#@Model.TaskItemId - @Model.TaskItem?.Title</dd>
            </dl>
        </div>
    </div>

    <form asp-controller="DataAttachments" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="DataAttachments" asp-action="Attachments" class="btn btn-outline-secondary">Cancel</a>
    </form>
</section>