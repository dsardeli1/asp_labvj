@model TaskManageApp.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<section class="data-entity-page data-entity-page-form">
    <header class="data-entity-header">
        <h2>Edit User</h2>
        <p class="text-muted">Edit user record.</p>
    </header>

    <form asp-controller="DataUsers" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input asp-for="Username" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password Hash</label>
            <input asp-for="PasswordHash" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="DataUsers" asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
    </form>
</section>
