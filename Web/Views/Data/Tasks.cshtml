@model List<TaskManageApp.Models.TaskItem>

@{
    ViewData["Title"] = "Task Items";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Task Items</h2>
        <p class="text-muted">Read-only detail view of task records.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataTasks" asp-action="Create" class="btn btn-primary btn-sm">Create Task</a>
            <a asp-controller="DataTasks" asp-action="Tasks" class="btn btn-outline-secondary btn-sm">All</a>
            <a asp-controller="DataTasks" asp-action="PendingTasks" class="btn btn-outline-secondary btn-sm">Pending</a>
            <a asp-controller="DataTasks" asp-action="CompletedTasks" class="btn btn-outline-secondary btn-sm">Completed</a>
        </div>
    </header>

    <div class="table-responsive data-entity-table-wrap" style="overflow-x:auto;">
        <table class="table table-striped table-hover align-middle data-entity-table" style="min-width:1100px;">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Assigned User</th>
                    <th>Category</th>
                    <th>Comments</th>
                    <th>Created</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-controller="DataTasks" asp-action="TaskDetails" asp-route-id="@item.Id">@item.Id</a></td>
                        <td>@item.Title</td>
                        <td>@((Priority)item.PriorityId)</td>
                        <td>
                            @if (item.User != null)
                            {
                                <a asp-controller="DataTasks" asp-action="TasksByUser" asp-route-userId="@item.UserId">@(item.User.FirstName) @(item.User.LastName)</a>
                            }
                        </td>
                        <td>
                            @if (item.Category != null)
                            {
                                <a asp-controller="DataTasks" asp-action="TasksByCategory" asp-route-categoryId="@item.CategoryId">@item.Category.Name</a>
                            }
                        </td>
                        <td>@(item.Comments?.Count ?? 0)</td>
                        <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.IsCompleted)
                            {
                                <a asp-controller="DataTasks" asp-action="CompletedTasks">Completed</a>
                            }
                            else
                            {
                                <a asp-controller="DataTasks" asp-action="PendingTasks">Open</a>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-controller="DataTasks" asp-action="TaskDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                <a asp-controller="DataTasks" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-controller="DataTasks" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
