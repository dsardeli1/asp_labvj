@model TaskManageApp.Models.TaskAttachment

@{
    ViewData["Title"] = "Create Attachment";
    var tasks = ViewData["Tasks"] as List<TaskManageApp.Models.TaskItem>;
}

<section class="data-entity-page data-entity-page-detail">
    <header class="data-entity-header">
        <h2>Create Attachment</h2>
        <p class="text-muted">Add a new task attachment record.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataAttachments" asp-action="Attachments" class="btn btn-outline-secondary btn-sm">Back to Attachments</a>
        </div>
    </header>

    <div class="card mb-3 data-detail-card">
        <div class="card-body data-detail-card-body">
            <form asp-controller="DataAttachments" asp-action="Create" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-6">
                    <label asp-for="FileName" class="form-label"></label>
                    <input asp-for="FileName" class="form-control" maxlength="255" />
                    <span asp-validation-for="FileName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TaskItemId" class="form-label"></label>
                    <select asp-for="TaskItemId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(tasks, "Id", "Title"))">
                        <option value="">-- Select Task --</option>
                    </select>
                    <span asp-validation-for="TaskItemId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="FilePath" class="form-label"></label>
                    <input asp-for="FilePath" class="form-control" maxlength="500" />
                    <span asp-validation-for="FilePath" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-controller="DataAttachments" asp-action="Attachments" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

<partial name="_ValidationScriptsPartial" />