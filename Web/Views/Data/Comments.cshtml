@model List<TaskManageApp.Models.Comment>

@{
    ViewData["Title"] = "Comments";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Comments</h2>
        <p class="text-muted">Manage comment records.</p>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="data-entity-actions">
            <a asp-controller="DataComments" asp-action="Create" class="btn btn-primary btn-sm">Create Comment</a>
        </div>
    </header>

    <div class="table-responsive data-entity-table-wrap">
        <table class="table table-striped table-hover align-middle data-entity-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Content</th>
                    <th>Task</th>
                    <th>User</th>
                    <th>Created</th>
                    <th>Edited</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var comment in Model)
                {
                    <tr>
                        <td><a asp-controller="DataComments" asp-action="CommentDetails" asp-route-id="@comment.Id">@comment.Id</a></td>
                        <td>@comment.Content</td>
                        <td>#@comment.TaskItemId - @comment.TaskItem?.Title</td>
                        <td>@comment.User?.Username</td>
                        <td>@comment.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(comment.IsEdited ? "Yes" : "No")</td>
                        <td>
                            <a asp-controller="DataComments" asp-action="CommentDetails" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-info">View</a>
                            <a asp-controller="DataComments" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-controller="DataComments" asp-action="Delete" asp-route-id="@comment.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
