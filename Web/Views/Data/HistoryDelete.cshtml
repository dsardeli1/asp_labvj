@model TaskManageApp.Models.TaskHistory

@{
    ViewData["Title"] = "Delete History";
}

<section class="data-entity-page data-entity-page-detail">
    <header class="data-entity-header">
        <h2>Delete History #@Model.Id</h2>
        <p class="text-muted">Confirm deletion of this task history record.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataHistories" asp-action="Histories" class="btn btn-outline-secondary btn-sm">Back to Histories</a>
        </div>
    </header>

    <div class="card mb-3 data-detail-card">
        <div class="card-body data-detail-card-body">
            <div class="alert alert-danger" role="alert">
                <strong>Warning!</strong> This action permanently deletes the history record and cannot be undone.
            </div>
            <dl class="row mb-0 data-detail-grid">
                <dt class="col-sm-3 data-detail-term">Task</dt>
                <dd class="col-sm-9 data-detail-desc">#@Model.TaskItemId - @Model.TaskItem?.Title</dd>
                <dt class="col-sm-3 data-detail-term">Action</dt>
                <dd class="col-sm-9 data-detail-desc">@Model.Action</dd>
                <dt class="col-sm-3 data-detail-term">Action Date</dt>
                <dd class="col-sm-9 data-detail-desc">@Model.ActionDate.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>
    </div>

    <form asp-controller="DataHistories" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="DataHistories" asp-action="Histories" class="btn btn-outline-secondary">Cancel</a>
    </form>
</section>