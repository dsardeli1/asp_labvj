@model TaskManageApp.Models.Comment

@{
    ViewData["Title"] = "Edit Comment";
    var tasks = ViewData["Tasks"] as List<TaskManageApp.Models.TaskItem>;
    var users = ViewData["Users"] as List<TaskManageApp.Models.User>;
}

<section class="data-entity-page data-entity-page-detail">
    <header class="data-entity-header">
        <h2>Edit Comment #@Model.Id</h2>
        <p class="text-muted">Update comment record.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataComments" asp-action="Comments" class="btn btn-outline-secondary btn-sm">Back to Comments</a>
        </div>
    </header>

    <div class="card mb-3 data-detail-card">
        <div class="card-body data-detail-card-body">
            <form asp-controller="DataComments" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Id" type="hidden" />

                <div class="col-md-6">
                    <label asp-for="TaskItemId" class="form-label"></label>
                    <select asp-for="TaskItemId" class="form-select" asp-items="@(new SelectList(tasks, "Id", "Title"))" data-autocomplete-url="/data/tasks/lookup" data-autocomplete-placeholder="Search tasks">
                        <option value="">-- Select Task --</option>
                    </select>
                    <span asp-validation-for="TaskItemId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UserId" class="form-label"></label>
                    <select asp-for="UserId" class="form-select" asp-items="@(new SelectList(users, "Id", "Username"))" data-autocomplete-url="/data/users/lookup" data-autocomplete-placeholder="Search users">
                        <option value="">-- Select User --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="4" maxlength="2000"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-controller="DataComments" asp-action="Comments" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
