@model List<TaskManageApp.Models.TaskHistory>

@{
    ViewData["Title"] = "Task Histories";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Task Histories</h2>
        <p class="text-muted">Manage task history records.</p>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="data-entity-actions">
            <a asp-controller="DataHistories" asp-action="Create" class="btn btn-primary btn-sm">Create History</a>
        </div>
        <form asp-controller="DataHistories" asp-action="Find" method="get" class="row g-2 mt-2">
            <div class="col-md-8 col-lg-6">
                <select name="id" class="form-select" data-autocomplete-url="/data/histories/lookup" data-autocomplete-placeholder="Quick find history by action" data-autocomplete-max-results="12">
                    <option value="">Quick find history...</option>
                    @foreach (var history in Model.OrderByDescending(h => h.ActionDate).ThenBy(h => h.Id))
                    {
                        <option value="@history.Id">#@history.Id - @history.Action</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Open</button>
            </div>
        </form>
    </header>

    <div class="table-responsive data-entity-table-wrap">
        <table class="table table-striped table-hover align-middle data-entity-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Task</th>
                    <th>Action</th>
                    <th>Action Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var history in Model)
                {
                    <tr>
                        <td><a asp-controller="DataHistories" asp-action="HistoryDetails" asp-route-id="@history.Id">@history.Id</a></td>
                        <td>#@history.TaskItemId - @history.TaskItem?.Title</td>
                        <td>@history.Action</td>
                        <td>@history.ActionDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-controller="DataHistories" asp-action="HistoryDetails" asp-route-id="@history.Id" class="btn btn-sm btn-outline-info">View</a>
                            <a asp-controller="DataHistories" asp-action="Edit" asp-route-id="@history.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-controller="DataHistories" asp-action="Delete" asp-route-id="@history.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
