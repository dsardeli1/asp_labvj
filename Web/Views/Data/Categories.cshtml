@model List<TaskManageApp.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Categories</h2>
        <p class="text-muted">Browse categories and manage records.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataCategories" asp-action="Create" class="btn btn-primary btn-sm">Create Category</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="table-responsive data-entity-table-wrap">
        <table class="table table-striped table-hover align-middle data-entity-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Color</th>
                    <th>Created</th>
                    <th>Active</th>
                    <th>Task Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td><a asp-controller="DataCategories" asp-action="CategoryDetails" asp-route-id="@category.Id">@category.Id</a></td>
                        <td>@category.Name</td>
                        <td>@category.Description</td>
                        <td>
                            <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:@category.Color;border:1px solid #999;margin-right:6px;"></span>
                            @category.Color
                        </td>
                        <td>@category.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>@(category.IsActive ? "Yes" : "No")</td>
                        <td>@(category.Tasks?.Count ?? 0)</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Category actions">
                                <a asp-controller="DataCategories" asp-action="CategoryDetails" asp-route-id="@category.Id" class="btn btn-outline-secondary">View</a>
                                <a asp-controller="DataCategories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-secondary">Edit</a>
                                <a asp-controller="DataCategories" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
