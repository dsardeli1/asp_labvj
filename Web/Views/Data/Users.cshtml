@model List<TaskManageApp.Models.User>

@{
    ViewData["Title"] = "Users";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Users</h2>
        <p class="text-muted">Read-only detail view of user records.</p>
        <div class="data-entity-actions">
            <a asp-controller="DataUsers" asp-action="Create" class="btn btn-primary btn-sm">Create User</a>
            <a asp-controller="DataUsers" asp-action="Users" class="btn btn-outline-secondary btn-sm">All</a>
            <a asp-controller="DataUsers" asp-action="UsersWithTasks" class="btn btn-outline-secondary btn-sm">With Tasks</a>
            <a asp-controller="DataUsers" asp-action="UsersWithoutTasks" class="btn btn-outline-secondary btn-sm">Without Tasks</a>
        </div>
    </header>

    <div class="table-responsive data-entity-table-wrap" style="overflow-x:auto;">
        <table class="table table-striped table-hover align-middle data-entity-table" style="min-width:1000px;">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Created At</th>
                    <th>Task Count</th>
                    <th>Comment Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td><a asp-controller="DataUsers" asp-action="UserDetails" asp-route-id="@user.Id">@user.Id</a></td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@(user.Tasks?.Count ?? 0)</td>
                        <td>@(user.Comments?.Count ?? 0)</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-controller="DataUsers" asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                <a asp-controller="DataUsers" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-controller="DataUsers" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
