@model List<TaskManageApp.Models.User>

@{
    ViewData["Title"] = "Users";
}

<section class="data-entity-page data-entity-page-list">
    <header class="data-entity-header">
        <h2>Users</h2>
        <p class="text-muted">Detail view of user records.</p>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="data-entity-actions">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="DataUsers" asp-action="Create" class="btn btn-primary btn-sm">Create User</a>
            }
            <a asp-controller="DataUsers" asp-action="Users" class="btn btn-outline-secondary btn-sm">All</a>
            <a asp-controller="DataUsers" asp-action="UsersWithTasks" class="btn btn-outline-secondary btn-sm">With Tasks</a>
            <a asp-controller="DataUsers" asp-action="UsersWithoutTasks" class="btn btn-outline-secondary btn-sm">Without Tasks</a>
        </div>
        <form asp-controller="DataUsers" asp-action="Find" method="get" class="row g-2 mt-2">
            <div class="col-md-8 col-lg-6">
                <select name="id" class="form-select" data-autocomplete-url="/data/users/lookup" data-autocomplete-placeholder="Quick find user by username or email" data-autocomplete-max-results="12">
                    <option value=""></option>
                    @foreach (var user in Model.OrderBy(u => u.Username).ThenBy(u => u.Id))
                    {
                        <option value="@user.Id">#@user.Id - @user.Username</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Open</button>
            </div>
        </form>
    </header>

    <div class="table-responsive data-entity-table-wrap" style="overflow-x:auto;">
        <table class="table table-striped table-hover align-middle data-entity-table" style="min-width:1000px;">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Created At</th>
                    <th>Task Count</th>
                    <th>Comment Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td><a asp-controller="DataUsers" asp-action="UserDetails" asp-route-id="@user.Id">@user.Id</a></td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@(user.Tasks?.Count ?? 0)</td>
                        <td>@(user.Comments?.Count ?? 0)</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-controller="DataUsers" asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info">View</a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <a asp-controller="DataUsers" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="DataUsers" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
