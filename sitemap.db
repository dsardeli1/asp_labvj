        "viewPath": "~/Web/Views/Data/TaskDetails.cshtml",
        "viewName": "TaskDetails",
        "description": "Task details page",
        "parameters": [
          { "name": "id", "type": "int", "required": true }
        ],
        "routeAttribute": "[Route(\"data/tasks\")][HttpGet(\"{id:int}\")]"
      },
      {
