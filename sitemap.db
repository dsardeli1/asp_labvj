{
  "routing": {
    "name": "TaskManageApp",
    "description": "Complete URL routing model for the refactored Web folder layout",
    "routingConfiguration": {
      "defaultRoute": "{controller=Home}/{action=Index}/{id?}",
      "attributeRouting": true,
      "frameworkVersion": ".NET 10.0"
    },
    "routes": [
      {
        "routeId": "R001",
        "url": "/",
        "httpMethod": "GET",
        "controller": "HomeController",
        "action": "Index",
        "viewPath": "~/Web/Views/Home/Index.cshtml",
        "viewName": "Index",
        "description": "Home page landing view",
        "parameters": [],
        "routeAttribute": "[Route(\"\")]"
      },
      {
        "routeId": "R002",
        "url": "/tasks",
        "httpMethod": "GET",
        "controller": "HomeController",
        "action": "Tasks",
        "viewPath": "~/Web/Views/Home/Tasks.cshtml",
        "viewName": "Tasks",
        "description": "Task dashboard with sorting and completion filters",
        "parameters": [
          { "name": "prioritySort", "type": "string", "defaultValue": "none" },
          { "name": "dueDateSort", "type": "string", "defaultValue": "none" },
          { "name": "showCompleted", "type": "bool", "defaultValue": "true" }
        ],
        "routeAttribute": "[HttpGet(\"tasks\")]"
      },
      {
        "routeId": "R003",
        "url": "/incomplete-tasks",
        "httpMethod": "GET",
        "controller": "HomeController",
        "action": "IncompleteTasks",
        "viewPath": "~/Web/Views/Home/Tasks.cshtml",
        "viewName": "Tasks",
        "description": "Task dashboard filtered to incomplete items",
        "parameters": [
          { "name": "prioritySort", "type": "string", "defaultValue": "none" },
          { "name": "dueDateSort", "type": "string", "defaultValue": "none" }
        ],
        "routeAttribute": "[HttpGet(\"incomplete-tasks\")]"
      },
      {
        "routeId": "R004",
        "url": "/privacy",
        "httpMethod": "GET",
        "controller": "HomeController",
        "action": "Privacy",
        "viewPath": "~/Web/Views/Home/Privacy.cshtml",
        "viewName": "Privacy",
        "description": "Privacy policy page",
        "parameters": [],
        "routeAttribute": "[HttpGet - Convention based]"
      },
      {
        "routeId": "R005",
        "url": "/error",
        "httpMethod": "GET",
        "controller": "HomeController",
        "action": "Error",
        "viewPath": "~/Web/Views/Home/Error.cshtml",
        "viewName": "Error",
        "description": "Error page used by exception handling",
        "parameters": [],
        "routeAttribute": "[HttpGet - Convention based]",
        "notes": "Also used by /Home/Error"
      },
      {
        "routeId": "R006",
        "url": "/data/tasks",
        "httpMethod": "GET",
        "controller": "DataTasksController",
        "action": "Tasks",
        "viewPath": "~/Web/Views/Data/Tasks.cshtml",
        "viewName": "Tasks",
        "description": "List all tasks in the data browser",
        "parameters": [],
        "routeAttribute": "[Route(\"data/tasks\")][HttpGet(\"\")]"
      },
      {
        "routeId": "R007",
